
@page "/planning"

<PageTitle>MISSION PLANNING | IRON VEIL</PageTitle>

<div class="planning-screen">
    <header class="planning-header">
        <div>
            <span class="planning-brand">IRON VEIL</span>
            <span class="planning-divider">/</span>
            <span class="planning-section">MISSION PLANNING</span>
        </div>
        <span class="planning-status">MISSION CONFIGURATION</span>
    </header>

    <div class="planning-body">
        <aside class="planning-panel">
            <h2>MISSION</h2>
            <p class="panel-label">OPERATION</p>
            <h3>IRON HORIZON</h3>
            <p class="panel-description">
                Training compound exercise. Plan your squad's route
                and complete the assigned objectives.
            </p>

            <div class="panel-divider"></div>

            <h2>OBJECTIVES</h2>

            <div class="objective-item">
                <span class="objective-number">01</span>
                <div>
                    <strong>RALLY POINT</strong>
                    <small>Initial destination</small>
                </div>
            </div>

            <div class="objective-item">
                <span class="objective-number">02</span>
                <div>
                    <strong>COMMUNICATIONS</strong>
                    <small>Complete assigned task</small>
                </div>
            </div>

            <div class="objective-item">
                <span class="objective-number">03</span>
                <div>
                    <strong>EXTRACTION</strong>
                    <small>Return to deployment area</small>
                </div>
            </div>

            <div class="panel-divider"></div>

            <h2>SQUAD</h2>

            <div class="squad-member">
                <span class="member-dot"></span>
                <span>01 — SQUAD LEADER</span>
            </div>
            <div class="squad-member">
                <span class="member-dot"></span>
                <span>02 — TEAM MEMBER</span>
            </div>
            <div class="squad-member">
                <span class="member-dot"></span>
                <span>03 — TEAM MEMBER</span>
            </div>
            <div class="squad-member">
                <span class="member-dot"></span>
                <span>04 — TEAM MEMBER</span>
            </div>
        </aside>

        <section class="planning-map-area">
            <div class="map-toolbar">
                <span>TRAINING COMPOUND</span>
                <span>MAP GRID // 01</span>
            </div>

            <div class="map-placeholder">
                <div class="map-grid"></div>
                <div class="map-road road-horizontal"></div>
                <div class="map-road road-vertical"></div>

                <div class="map-building building-one">BUILDING A</div>
                <div class="map-building building-two">BUILDING B</div>
                <div class="map-building building-three">BUILDING C</div>

                <div class="map-marker start-marker">START</div>
                <div class="map-marker objective-marker">OBJ 01</div>
                <div class="map-marker objective-marker marker-two">OBJ 02</div>
                <div class="map-marker extraction-marker">EXTRACT</div>

                <div class="map-center-label">TRAINING COMPOUND</div>
            </div>

            <div class="map-footer">
                <span>MAP: TRAINING AREA</span>
                <span>ROUTE PLANNING: NOT CONFIGURED</span>
            </div>
        </section>

        <aside class="planning-panel right-panel">
            <h2>ROUTE PLANNING</h2>
            <p class="panel-description">
                Assign destinations and organize your squad's planned route.
            </p>

            <div class="panel-divider"></div>

            <h2>FORMATION</h2>
            <select class="planning-select">
                <option>Column</option>
                <option>Line</option>
                <option>Wedge</option>
                <option>Custom</option>
            </select>

            <div class="panel-divider"></div>

            <h2>ROUTE</h2>
            <p class="panel-description">
                No waypoints assigned.
            </p>

            <button class="planning-action">CLEAR ROUTE</button>

            <div class="deploy-section">
                <span class="planning-status">CONFIGURATION INCOMPLETE</span>
                <button class="deploy-button" disabled>DEPLOY SQUAD</button>
            </div>
        </aside>
    </div>
</div>
