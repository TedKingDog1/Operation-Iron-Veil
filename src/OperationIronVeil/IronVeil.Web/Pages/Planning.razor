@page "/planning"
@inject IJSRuntime JS

<PageTitle>MISSION PLANNING | IRON VEIL</PageTitle>

<div class="planning-screen">
    <header class="planning-header">
        <div>
            <span class="planning-brand">IRON VEIL</span>
            <span class="planning-divider">/</span>
            <span class="planning-section">MISSION PLANNING</span>
        </div>
        <span class="planning-status">MISSION CONFIGURATION</span>
    </header>

    <div class="planning-body">
        <aside class="planning-panel">
            <h2>MISSION</h2>
            <p class="panel-label">OPERATION</p>
            <h3>IRON HORIZON</h3>
            <p class="panel-description">
                Training compound exercise. Plan your squad's route
                and complete the assigned objectives.
            </p>

            <div class="panel-divider"></div>

            <h2>OBJECTIVES</h2>

            @foreach (var objective in Objectives)
            {
                <div class="objective-item">
                    <span class="objective-number">@objective.Number</span>
                    <div>
                        <strong>@objective.Name</strong>
                        <small>@objective.Description</small>
                    </div>
                </div>
            }

            <div class="panel-divider"></div>

            <h2>SQUAD</h2>

            @foreach (var member in SquadMembers)
            {
                <button type="button"
                        class="squad-member squad-select @(SelectedSquadMemberId == member.Id ? "selected" : "")"
                        @onclick="() => SelectSquadMember(member.Id)">
                    <span class="member-dot"></span>
                    <span class="member-info">
                        <span>@member.Id — @member.Role</span>
                        <small>@(member.AssignedObjective ?? "NO OBJECTIVE ASSIGNED")</small>
                    </span>
                    @if (SelectedSquadMemberId == member.Id)
                    {
                        <span class="selected-indicator">SELECTED</span>
                    }
                </button>
            }
        </aside>

        <section class="planning-map-area">
            <div class="map-toolbar">
                <span>TRAINING COMPOUND</span>
                <span>MAP GRID // 01</span>
            </div>

            <div class="map-placeholder" @ref="mapElement" @onclick="AddWaypoint" title="Click anywhere on the map to add a route waypoint">
                <div class="map-grid"></div>
                <div class="map-road road-horizontal"></div>
                <div class="map-road road-vertical"></div>

                <div class="map-building building-one">BUILDING A</div>
                <div class="map-building building-two">BUILDING B</div>
                <div class="map-building building-three">BUILDING C</div>

                <div class="map-marker start-marker">START</div>
                <div class="map-marker objective-marker">OBJ 01</div>
                <div class="map-marker objective-marker marker-two">OBJ 02</div>
                <div class="map-marker extraction-marker">EXTRACT</div>

                <svg class="route-overlay" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @if (Waypoints.Count > 0)
                    {
                        <polyline points="@RoutePoints" />
                    }
                </svg>

                @foreach (var waypoint in Waypoints)
                {
                    <div class="route-waypoint" style="@WaypointStyle(waypoint)">
                        <span>@waypoint.Number.ToString("00")</span>
                    </div>
                }

                <div class="map-center-label">TRAINING COMPOUND</div>
                <div class="map-click-hint">CLICK MAP TO ADD WAYPOINT</div>
            </div>

            <div class="map-footer">
                <span>MAP: TRAINING AREA</span>
                <span>@RouteStatus</span>
            </div>
        </section>

        <aside class="planning-panel right-panel">
            <h2>ROUTE PLANNING</h2>
            <p class="panel-description">
                Click the map to add destinations. Waypoints are connected in the order they are placed.
            </p>

            <div class="panel-divider"></div>

            <h2>FORMATION</h2>
            <select class="planning-select" @bind="SelectedFormation" aria-label="Squad formation">
                <option>Column</option>
                <option>Line</option>
                <option>Wedge</option>
            </select>

            <div class="formation-preview-panel">
                <div class="formation-preview-heading">
                    <span>FORMATION PREVIEW</span>
                    <strong>@SelectedFormation.ToUpperInvariant()</strong>
                </div>
                <div class="formation-preview @FormationCssClass" aria-label="@($"{SelectedFormation} formation preview")">
                    <span class="formation-front">FRONT</span>
                    @for (var i = 1; i <= 4; i++)
                    {
                        <div class="formation-unit unit-@i">
                            <span>@i.ToString("00")</span>
                        </div>
                    }
                </div>
                <small class="formation-note">SCHEMATIC SQUAD POSITIONS // 4 UNITS</small>
            </div>

            <div class="panel-divider"></div>

            <h2>SQUAD ASSIGNMENT</h2>
            <div class="assignment-selected">
                <span class="panel-label">SELECTED UNIT</span>
                <strong>@(SelectedSquadMember is null ? "NONE" : $"{SelectedSquadMember.Id} — {SelectedSquadMember.Role}")</strong>
                <small>CURRENT TASK: @(SelectedSquadMember?.AssignedObjective ?? "UNASSIGNED")</small>
            </div>

            <label class="assignment-label" for="objective-select">ASSIGN OBJECTIVE</label>
            <select id="objective-select" class="planning-select" @bind="SelectedObjective">
                @foreach (var objective in Objectives)
                {
                    <option value="@objective.Name">@objective.Name</option>
                }
            </select>

            <button type="button"
                    class="planning-action assignment-button"
                    @onclick="AssignObjective"
                    disabled="@(SelectedSquadMember is null)">
                ASSIGN TO SELECTED UNIT
            </button>

            <button type="button"
                    class="planning-action clear-assignment-button"
                    @onclick="ClearAssignment"
                    disabled="@(SelectedSquadMember?.AssignedObjective is null)">
                CLEAR ASSIGNMENT
            </button>

            <div class="panel-divider"></div>

            <div class="route-heading">
                <h2>ROUTE</h2>
                <span class="route-count">@Waypoints.Count.ToString("00")</span>
            </div>

            @if (Waypoints.Count == 0)
            {
                <p class="panel-description route-empty">No waypoints assigned. Click the map to begin.</p>
            }
            else
            {
                <ol class="route-list">
                    @foreach (var waypoint in Waypoints)
                    {
                        <li>
                            <span class="route-list-number">@waypoint.Number.ToString("00")</span>
                            <span>WAYPOINT @waypoint.Number.ToString("00")</span>
                        </li>
                    }
                </ol>
            }

            <button class="planning-action" @onclick="ClearRoute" disabled="@(Waypoints.Count == 0)">CLEAR ROUTE</button>

            <div class="deploy-section">
                <span class="planning-status">@(Waypoints.Count > 0 ? "ROUTE CONFIGURED" : "AWAITING WAYPOINTS")</span>
                <button class="deploy-button" disabled title="Squad deployment will be added in a later development stage">DEPLOY SQUAD</button>
                <small class="deployment-note">DEPLOYMENT SYSTEM IN DEVELOPMENT</small>
            </div>
        </aside>
    </div>
</div>

@code {
    private ElementReference mapElement;
    private List<Waypoint> Waypoints { get; } = new();
    private string SelectedFormation { get; set; } = "Column";
    private string FormationCssClass => SelectedFormation.ToLowerInvariant();

    private List<Objective> Objectives { get; } = new()
    {
        new("01", "RALLY POINT", "Initial destination"),
        new("02", "COMMUNICATIONS", "Complete assigned task"),
        new("03", "EXTRACTION", "Return to deployment area")
    };

    private List<SquadMember> SquadMembers { get; } = new()
    {
        new("01", "SQUAD LEADER"),
        new("02", "TEAM MEMBER"),
        new("03", "TEAM MEMBER"),
        new("04", "TEAM MEMBER")
    };

    private string SelectedSquadMemberId { get; set; } = "01";
    private string SelectedObjective { get; set; } = "RALLY POINT";

    private SquadMember? SelectedSquadMember =>
        SquadMembers.FirstOrDefault(member => member.Id == SelectedSquadMemberId);

    private string RouteStatus => Waypoints.Count == 0
        ? "ROUTE PLANNING: NOT CONFIGURED"
        : $"ROUTE PLANNING: {Waypoints.Count} WAYPOINT{(Waypoints.Count == 1 ? "" : "S")}";

    private string RoutePoints => string.Join(" ", new[] { "8,85" }
        .Concat(Waypoints.Select(point => $"{point.X:F2},{point.Y:F2}")));

    private void SelectSquadMember(string memberId)
    {
        SelectedSquadMemberId = memberId;
    }

    private void AssignObjective()
    {
        if (SelectedSquadMember is not null)
        {
            SelectedSquadMember.AssignedObjective = SelectedObjective;
        }
    }

    private void ClearAssignment()
    {
        if (SelectedSquadMember is not null)
        {
            SelectedSquadMember.AssignedObjective = null;
        }
    }

    private async Task AddWaypoint(MouseEventArgs args)
    {
        var point = await JS.InvokeAsync<MapPoint>(
            "ironVeilMap.getRelativePosition",
            mapElement,
            args.ClientX,
            args.ClientY);

        Waypoints.Add(new Waypoint(
            Waypoints.Count + 1,
            Math.Clamp(point.X, 2, 98),
            Math.Clamp(point.Y, 2, 98)));
    }

    private void ClearRoute()
    {
        Waypoints.Clear();
    }

    private static string WaypointStyle(Waypoint waypoint) =>
        $"left: {waypoint.X.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%; " +
        $"top: {waypoint.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%;";

    private sealed record Objective(string Number, string Name, string Description);

    private sealed class SquadMember(string id, string role)
    {
        public string Id { get; } = id;
        public string Role { get; } = role;
        public string? AssignedObjective { get; set; }
    }

    private sealed record Waypoint(int Number, double X, double Y);

    private sealed class MapPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
    }
}
